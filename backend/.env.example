# Copiază fișierul ca `.env` și completează valorile.
#
# Atenție: variabilele deja exportate în shell au întâietate — `dotenv` nu le
# suprascrie. Dacă ai un `PORT` în profilul de shell, acesta câștigă în fața
# rândului de mai jos, iar serverul pornește pe alt port decât crezi.

DATABASE_URL=postgresql://postgres:parola@localhost:5432/clinica

# Minimum 32 de caractere, altfel serverul refuză să pornească. Generează unul:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=schimba_cu_un_sir_aleatoriu_lung_de_minimum_32_caractere
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development

# Origini suplimentare permise la CORS, separate prin virgulă.
# Se ADAUGĂ la cele implicite: localhost:1420, localhost:5173 și originile
# Tauri (tauri://localhost, http://tauri.localhost).
CORS_ORIGINS=
