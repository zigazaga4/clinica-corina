{
  "name": "clinica-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:schema": "psql -v ON_ERROR_STOP=1 -d \"${DATABASE_URL:-clinica}\" -f sql/01_schema.sql",
    "seed": "tsx src/seed.ts",
    "parola-statistici": "tsx src/parola-statistici.ts",
    "test:db": "tsx src/test-db.ts",
    "test:api": "tsx src/test-api.ts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "argon2@0.41.1": true
  }
}
