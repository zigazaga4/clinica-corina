# Copiază fișierul ca `.env.local`.
#
# Adresa backend-ului. Prezentă = aplicația vorbește cu serverul real;
# absentă (sau comentată) = date demo, în memorie, fără server pornit.
#
# Backend: ../backend  ->  PORT=3001 npm run dev
VITE_API_URL=http://localhost:3001

# Ce știe aplicația să arate. Fork-ul pentru Corina Burcut pornește SIMPLU:
# calendar, clienți, proceduri cu culori. Lipsă sau altceva decât `true` = oprit.
#
# Prețuri, plăți, restanțe, produse, Statistici, cheltuieli, „Ședințe pe persoane”:
# VITE_FUNCTIE_COSTURI=true
# Serviciile în mai multe ședințe (abonamente), pagina „Tratamente”:
# VITE_FUNCTIE_TRATAMENTE=true
